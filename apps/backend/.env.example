# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ec-store

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── HTTP ──────────────────────────────────────────────────────────────────────
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:9000

# ── Secrets ───────────────────────────────────────────────────────────────────
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# ── Admin bootstrap ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=Test1234!

# ── Seed images ───────────────────────────────────────────────────────────────
# Default (LOCAL): Medusa serves /static from apps/backend/static/ — works offline.
# The 8 product images (laptop-front.png … speaker-top.png) must exist in static/.
# They are committed to the repo so `task seed` works without network access.
#
# To seed from the upstream public bucket instead, uncomment the line below.
# This is a reference fallback only — never hardcode the bucket URL in seed logic.
# SEED_IMAGE_BASE_URL=https://medusa-public-images.s3.eu-west-1.amazonaws.com
