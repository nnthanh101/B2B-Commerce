# =============================================================
# Medusa Backend — Environment Template
# Copy to apps/backend/.env and fill in values.
# Never commit apps/backend/.env (gitignored).
# =============================================================

# CORS — comma-separated origins allowed for Store, Admin, and Auth APIs
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# Database — PostgreSQL connection string
# Docker default: postgres://postgres:postgres@postgres:5432/medusa-store
# Bare-metal default: postgres://postgres:postgres@localhost:5432/medusa-store
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-store

# Redis — session cache connection string
# Docker default: redis://redis:6379
# Bare-metal default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Secrets — generate unique values for production
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Admin credentials (set once on first run)
# ADMIN_EMAIL=admin@oceansoft.io
# ADMIN_PASSWORD=

# Medusa publishable key for storefront (set after first admin login)
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
