# ─────────────────────────────────────────────────────────────────────────────
# Storefront environment template
# Usage: cp apps/storefront/.env.template apps/storefront/.env
#        Then replace NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY with the derived value.
# ─────────────────────────────────────────────────────────────────────────────
# RESTART REQUIREMENT: Next.js inlines NEXT_PUBLIC_* at dev-server startup.
# After editing .env, run: docker compose restart storefront
# ─────────────────────────────────────────────────────────────────────────────

# Backend URL (Docker Compose: http://ec:9000, host dev: http://localhost:9000)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://ec:9000

# Publishable API Key — DERIVE from seeded backend, do not hardcode.
# Root cause of storefront-500 (DC-050): stale placeholder rejected by backend.
# Derive: docker exec ec_postgres psql -U postgres -d ec-store \\
#           -c "SELECT token FROM api_key WHERE type='publishable' LIMIT 1;"
# Validate: scripts/config-doctor.sh  Restart: docker compose restart storefront
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_REPLACE_WITH_SEEDED_KEY

NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=us
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=
REVALIDATE_SECRET=supersecret

NEXT_PUBLIC_DEFAULT_REGION=nz
