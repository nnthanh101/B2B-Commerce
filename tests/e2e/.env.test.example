# E2E Test Configuration (SSOT — Single Source of Truth)
# Copy this to .env.test and modify for your environment.
# These are local-dev defaults; DO NOT commit actual credentials.

# Backend API (Medusa backend + admin API)
BACKEND_URL=http://localhost:9000

# Storefront (buyer-facing React SPA)
STOREFRONT_URL=http://localhost:8000

# Admin authentication (for fixture setup)
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=Test1234!

# Publishable API key (for customer registration/login)
# This is a development key — NEVER use production keys in tests.
# For local testing, run `curl http://localhost:9000/admin/api-keys` with admin auth to retrieve.
# MEDUSA_PUBLISHABLE_KEY=pk_...

# Regional test variant (storefront URL path prefix)
TEST_REGION_COUNTRY=nz

# Feature flags (enable/disable specific test scenarios)
QUOTE_FEATURE_ENABLED=true
