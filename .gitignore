# ADLC framework symlinks (tracked as symlinks, not content)
.adlc
.claude
.mcp-enterprise.json
.mcp.json

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files — copy from .env.template; never commit secrets
.env
.env.local
.env.*.local
apps/backend/.env
apps/storefront/.env

# Build outputs
dist/
build/
.next/
.medusa/

# Turbo cache
.turbo/

# Evidence and temp files
tmp/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
.nyc_output/

# ───────── Terraform ─────────
.terraform/            # provider/module cache
*.tfstate              # state → S3 remote backend; never commit
*.tfstate.*
*.tfplan               # plan output (may contain secrets)
crash.log
crash.*.log
*.tfvars               # sensitive values (commit *.tfvars.example instead)
*.tfvars.json

# Lock files: ignore all EXCEPT the bootstrap genesis lock (pins providers for the
# one-time S3 state-bucket creation). All other locks regenerate on `terraform init`.
.terraform.lock.hcl
!infra/terraform/aws/bootstrap/.terraform.lock.hcl

# Tracked by default (NOT ignored): backend-*.hcl, .tflint.hcl, *.tftest.hcl

# Playwright
playwright-report/
test-results/
# transient autotest.sh capture scratch; named generated specs (e.g. cart-to-quote.spec.ts) ARE tracked
tests/e2e/generated/_*.spec.ts

# Observability secrets (ADR-007 §9 — MF-4 secrets hygiene)
observability/prometheus/.auth
.env.observability
infra/terraform/aws/bootstrap/.terraform.lock.hcl
infra/terraform/aws/.tflint.hcl
infra/terraform/aws/modules/appregistry/tests/appregistry_test.tftest.hcl
infra/terraform/aws/dev/backend-dev.hcl
infra/terraform/aws/local/backend-local.hcl
infra/terraform/aws/modules/foundation/tests/foundation_test.tftest.hcl
tags_test.tftest.hcl

# Docusaurus docs/ (build artifacts only — source is tracked)
docs/node_modules/
docs/site/
docs/.docusaurus/
# llms.txt — generated artifact (gen-llms-txt.sh); never hand-edit; not tracked in git
docs/llms.txt
docs/content/llms.txt

# act secret file — NEVER commit real tokens; copy from .secrets.example
.secrets
docker-compose.override.yml

# act local engine copy (not committed — pre-populated for act --bind)
_engine_src/
_engine/
.pnpm-store
